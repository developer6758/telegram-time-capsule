# Copy to .env (ignored). Supply actual developer-owned Telegram Login credentials.
CAPSULE_DB_PASSWORD=replace-with-random-local-password
CAPSULE_DATABASE_URL=postgres://capsule:replace-with-random-local-password@127.0.0.1:55432/capsule?sslmode=disable
CAPSULE_SERVICE_ID=time-capsule-dev
CAPSULE_SIGNING_KID=sign-v1
CAPSULE_WRAPPING_KID=wrap-v1
CAPSULE_SIGNING_KEY_FILE=.local/signing.pem
CAPSULE_WRAPPING_KEYS_FILE=.local/wrapping.json
CAPSULE_TLS_CERT_FILE=.local/tls.crt
CAPSULE_TLS_KEY_FILE=.local/tls.key
CAPSULE_LISTEN=127.0.0.1:8443
# Use the issuer from the current official Telegram Login setup.
CAPSULE_OIDC_ISSUER=https://oauth.telegram.org
CAPSULE_OIDC_CLIENT_ID=replace-with-your-client-id
CAPSULE_OIDC_CLIENT_SECRET=replace-with-your-backend-only-client-secret
CAPSULE_OIDC_CALLBACK_URL=https://your-trusted-service.example/v1/auth/callback
